---
import type { CollectionEntry } from "astro:content";
import SpotlightLink from "@components/react/SpotlightLink";
import FormattedDate from "@components/FormattedDate.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;

// Projects carry a category label ("RAG · Vision"); posts show their date instead.
const eyebrow = entry.collection === "projects" ? entry.data.category : undefined;
---

<SpotlightLink client:visible>
  <a href={`/${entry.collection}/${entry.slug}`} class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
    <div class="flex flex-col flex-1 truncate">
      {eyebrow && (
        <div class="font-mono text-xs opacity-75 truncate">
          {eyebrow}
        </div>
      )}
      {entry.collection === "blog" && (
        <div class="font-mono text-xs opacity-75">
          <FormattedDate date={entry.data.date} />
        </div>
      )}
      <div class="font-semibold text-black dark:text-white">
        {entry.data.title}
      </div>
      <div class="text-sm truncate">
        {entry.data.description}
      </div>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
      <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
    </svg>
  </a>
</SpotlightLink>
