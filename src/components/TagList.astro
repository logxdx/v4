---
type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <li class="rounded-full border border-black/15 px-2.5 py-0.5 font-mono text-xs dark:border-white/20">
        {tag}
      </li>
    ))}
  </ul>
)}
