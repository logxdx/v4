---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import StrokeHeading from "@components/react/StrokeHeading";
import ContactCard from "@components/react/ContactCard";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const thoughts = (await getCollection("thoughts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-20">
      <section class="space-y-5">
        <h1 class="text-black dark:text-white">
          <StrokeHeading client:load text="Hi, I'm Karan." fontSize={44} />
        </h1>
        <p class="text-black dark:text-white">
          <StrokeHeading client:load text="Research Engineer" fontSize={24} fontWeight={500} delay={0.5} />
        </p>
        <article class="space-y-1 prose-p:my-0">
          <p class="animate">
            I tinker with LLMs, agentic systems and the software around them.
          </p>
          <p class="animate">
            Building something with LLMs? Let's make it smarter, or at least faster.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-mono font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work"> See all work </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {
            work.map((entry) => (
              <li>
                <div class="font-mono text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
                <div class="font-mono font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="font-mono text-sm opacity-75">{entry.data.role}</div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-mono font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects"> See all projects </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-mono font-semibold text-black dark:text-white">Latest posts</h5>
          <Link href="/thoughts"> See all posts </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            thoughts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section> -->

      <section class="animate space-y-4">
        <h5 class="font-mono font-semibold text-black dark:text-white">Connect</h5>
        <div class="grid items-center gap-8 sm:grid-cols-[1fr_15rem]">
        <div class="space-y-4">
        <article>
          <p>
            Got a hard problem or a half-baked idea?
            <br />
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>Say hi</Link>. I reply
            faster than my models infer ;)
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL, i) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                >
                  {SOCIAL.NAME}
                </Link>
                {i < SOCIALS.length - 1 && "/"}
              </li>
            ))
          }
        </ul>
        </div>
        <div class="w-full max-w-[280px] sm:max-w-none">
          <ContactCard
            client:only="react"
            name={SITE.NAME}
            title="Research Engineer"
            handle="logxdx"
            handleUrl={SOCIALS.find((social) => social.NAME === "github")?.HREF ?? "https://github.com/logxdx"}
            email={SITE.EMAIL}
          />
        </div>
        </div>
      </section>
    </div>
  </Container>
</PageLayout>
