      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex gap-1">
        <Link href="/projects"> projects </Link>
        <span>
          {`/`}
        </span>
        <Link href="/work"> work </Link>
        <!-- <span>
          {`/`}
        </span>
        <Link href="/thoughts"> thoughts </Link> -->
      </nav>
    </GlassBar>
  </Container>
</header>
