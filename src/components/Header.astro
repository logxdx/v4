---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import GlassBar from "@components/react/GlassBar";
import ThemeButton from "@components/ThemeButton.astro";
import { SITE } from "@consts";
---

<header transition:persist="header">
  <Container>
    <GlassBar client:load>
      <Link href="/" underline={false}>
        <div class="font-semibold whitespace-nowrap">
          <span class="sm:hidden">{SITE.NAME.split(" ")[0]}</span>
          <span class="hidden sm:inline">{SITE.NAME}</span>
        </div>
      </Link>
      <div class="flex items-center gap-2 sm:gap-3">
        <nav class="flex gap-1">
          <Link href="/projects"> projects </Link>
          <span>
            {`/`}
          </span>
          <Link href="/blog"> blog </Link>
          <span>
            {`/`}
          </span>
          <Link href="/work"> work </Link>
        </nav>
        <ThemeButton />
      </div>
    </GlassBar>
  </Container>
</header>
